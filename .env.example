# ── GabiElectricals environment — copy to .env and fill ──
# Master switch. true = sample data mode: sandbox payments, notifications
# written to admin Notification Log, demo ribbon in admin. false = LIVE.
DEMO_MODE=true

# SQLite for zero-config demo. For production go live:
#   1) provider = "postgresql" in prisma/schema.prisma
#   2) DATABASE_URL below  3) npx prisma migrate deploy
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@localhost:5432/gabielectricals?schema=public"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=change…ndom

# LIVE PAYMENTS (Paystack): set DEMO_MODE=false and add your keys.
PAYSTACK_SECRET_KEY=
PAYST...KEY=
# Optional Flutterwave/Hubtel when enabled in gateway.ts:
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# SMS (Hubtel or Arkesel) + WhatsApp Business + email
SMS_PROVIDER=            # hubtel | arkesel | twilio
SMS_API_KEY=
***
ARKESE...KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
***
RESEND_API_KEY=          # or swap sendEmail() in src/lib/notify.ts for SMTP
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Google OAuth (optional — button hidden until set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

*** Admin bootstrap used by `npm run db:seed`
ADMIN_EMAIL=admin@gabielectricals.com
ADMIN_PASSWORD=***

# Analytics (IDs only — loader snippet in layout reads these)
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
